  m_text: "\n \uB2E8\uC21C \uAE30\uD638\uD488\uC774\uB77C \uD558\uB354\uB77C\uB3C4
    \uB300\uB9C8 \uC131\uBD84\uC774 \uD3EC\uD568\uB41C \uC81C\uD488\uC744 \uC2DD\uC57D\uCC98
    \uC2B9\uC778 \uC5C6\uC774 \uAD6D\uB0B4 \uBC18\uC785\uD560 \uACBD\uC6B0, \uCC98\uBC8C
    \uB300\uC0C1\uC774 \uB41C\uB2E4.\r\n\r\n \uB300\uB9C8 \uD569\uBC95\uD654 \uAD6D\uAC00\uC758
    \uC628\uB77C\uC778 \uC1FC\uD551\uBAB0\uC774\uB098 \uD604\uC9C0\uC5D0\uC11C, \uB300\uB9C8
    \uC131\uBD84\uC744 \uC758\uBBF8\uD558\uB294 \uBB38\uAD6C(Hemp, Cannabis, THC,
    CBD, CBN \uB4F1)\uB098 \uB300\uB9C8\uC78E \uBAA8\uC591\uC758 \uADF8\uB9BC \uBC0F
    \uC0AC\uC9C4\uC774 \uC788\uB294 \uC81C\uD488\uC740 \uAD6C\uB9E4\uD574\uC11C\uB294
    \uC548 \uB41C\uB2E4.\r\n\r\n \uD574\uC678\uC5D0 \uAC70\uC8FC\uD558\uB294 \uC9C0\uC778
    \uB4F1\uC73C\uB85C\uBD80\uD130 \uC774\uB7EC\uD55C \uC81C\uD488\uC744 \uC120\uBB3C\uBC1B\uC558\uB2E4
    \uD558\uB354\uB77C\uB3C4 \uD574\uC678\uC5D0\uC11C \uC12D\uCDE8\uD558\uAC70\uB098
    \uAD6D\uB0B4 \uBC18\uC785 \uACFC\uC815\uC5D0\uC11C \uCC98\uBC8C\uBC1B\uC744 \uC218
    \uC788\uB2E4.\r\n\r\n \uAD00\uC138\uCCAD\uC740 \uC55E\uC73C\uB85C\uB3C4 \uC8FC\uC694
    \uB9C8\uC57D\uB958\uBFD0 \uC544\uB2C8\uB77C \uAC01\uC885 \uB300\uB9C8 \uC81C\uD488\uC744
    \uCCA0\uC800\uD788 \uCC28\uB2E8\uD558\uC5EC \uAD6D\uBBFC \uC548\uC804\uC5D0 \uCD1D\uB825\uC744
    \uAE30\uC6B8\uC77C \uAC83\uC774\uB77C \uBC1D\uD614\uB2E4."
