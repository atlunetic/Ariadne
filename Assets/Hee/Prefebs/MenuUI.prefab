  m_text: "\n \uBC29\uD559\uC744 \uB9DE\uC774\uD558\uC5EC \uD574\uC678\uC5EC\uD589\uC744
    \uD558\uB294 \uAD6D\uBBFC\uC774 \uB298\uC5B4\uB09C \uAC00\uC6B4\uB370, \uAD00\uC138\uCCAD\uC5D0\uC11C\uB294
    \uB2E4\uC591\uD55C \uD615\uD0DC\uC758 \uB300\uB9C8 \uC81C\uD488\uC5D0 \uB300\uD55C
    \uAC01\uBCC4\uD55C \uC8FC\uC758\uB97C \uB2F9\uBD80\uD588\uB2E4.\r\n\r\n \uB300\uB9C8
    \uD569\uBC95\uD654 \uAD6D\uAC00\uC5D0\uC11C\uB294 \uC824\uB9AC, \uCD08\uCF5C\uB9BF,
    \uC624\uC77C, \uD654\uC7A5\uD488 \uB4F1 \uC5EC\uB7EC \uAE30\uD638\uD488 \uD615\uD0DC\uC758
    \uB300\uB9C8 \uC81C\uD488\uC774 \uC81C\uC870 \uBC0F \uC720\uD1B5\uB418\uACE0
    \uC788\uB2E4.\r\n\r\n \uB530\uB77C\uC11C \uD574\uB2F9 \uAD6D\uAC00(\uBBF8\uAD6D
    24\uAC1C\uC8FC \uBC0F \uC6CC\uC2F1\uD134\uB514\uC528, \uCE90\uB098\uB2E4, \uD0DC\uAD6D,
    \uC6B0\uB8E8\uACFC\uC774, \uBAB0\uD0C0, \uB8E9\uC148\uBD80\uB974\uD06C, \uC870\uC9C0\uC544,
    \uB0A8\uC544\uD504\uB9AC\uCE74\uACF5\uD654\uAD6D\uB4F1)\uB97C \uC5EC\uD589\uD560
    \uACBD\uC6B0 \uB354\uC6B1 \uC8FC\uC758\uD574\uC57C \uD55C\uB2E4.\r"
