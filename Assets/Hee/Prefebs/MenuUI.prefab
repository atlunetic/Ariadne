--- !u!114 &9085168296276359047
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8784539826599701267}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " \uCD5C\uADFC \uBE44\uB300\uBA74 \uB9C8\uC57D\uAC70\uB798\uAC00 \uD65C\uAC1C\uCE58\uBA74\uC11C,
    \uB300\uD559\uC0DD\uACFC \uC0AC\uD68C\uCD08\uB144\uC0DD\uC744 \uB9C8\uC57D \uC6B4\uBC18\uCC45\uC5D0
    \uAC00\uB2F4\uC2DC\uD0A4\uB294 \uC0AC\uB840\uAC00 \uC99D\uAC00\uD588\uB2E4.\r\n\r\n
    A\uC528\uB294 SNS\uB97C \uD1B5\uD574 \uB2E8\uAE30 \uACE0\uC218\uC775 \uC544\uB974\uBC14\uC774\uD2B8\uB97C
    \uC81C\uC548\uBC1B\uC558\uACE0, \uD574\uC678\uB85C \uAC00\uBC29\uC744 \uC6B4\uBC18\uD558\uB2E4
    \uC790\uC2E0\uB3C4 \uBAA8\uB974\uB294 \uC0AC\uC774\uC5D0 \uB9C8\uC57D \uC6B4\uBC18\uCC45\uC774
    \uB418\uC5B4 \uB9C8\uC57D \uC6B4\uBC18 \uD610\uC758\uB85C \uCCB4\uD3EC\uB418\uC5C8\uB2E4.\r\n\r\n
    B\uC528\uB294 \uAD6D\uC81C\uAE30\uAD6C \uAD00\uACC4\uC790\uB97C \uC0AC\uCE6D\uD55C
    \uC0AC\uB78C\uC73C\uB85C\uBD80\uD130 \uC5C5\uBB34\uB300\uD589 \uBC0F \uACC4\uC57D\uCCB4\uACB0\uC744
    \uBA85\uBAA9\uC73C\uB85C \uD574\uC678 \uCD9C\uAD6D\uC744 \uBD80\uD0C1\uBC1B\uC558\uB2E4.
    \r\n\r\n \uD574\uC678\uC5D0\uC11C \uC11C\uB958 \uAC00\uBC29\uC744 \uC804\uB2EC\uBC1B\uC740
    B\uC528\uB294 \uCC98\uC74C\uACFC \uB2E4\uB978 \uC870\uAC74\uC5D0 \uC758\uC2EC\uC744
    \uD488\uACE0 \uACF5\uAD00\uC5D0 \uC2E0\uACE0\uD558\uC600\uACE0, \uC11C\uB958
    \uAC00\uBC29 \uC548\uC5D0\uB294 \uB9C8\uC57D\uC774 \uC228\uACA8\uC838 \uC788\uC5C8\uB2E4.\r\n\r\n
    \uC774\uC678\uC5D0\uB3C4 \uCC98\uC74C\uC5D0\uB294 \uC6B4\uBC18\uCC45\uC73C\uB85C
    \uC811\uADFC\uC2DC\uD0A8 \uD6C4, \uC2E4\uC81C\uB85C \uB9C8\uC57D\uB958\uB97C
    \uD22C\uC57D\uD558\uAC8C \uD558\uC5EC \uC911\uB3C5\uC790\uB85C \uB9CC\uB4E0 \uACBD\uC6B0\uB3C4
    \uC788\uB2E4.\r\n\r\n \uB530\uB77C\uC11C \uBE44\uB300\uBA74 \uB9C8\uC57D \uAC70\uB798\uC758
    \uC0AC\uD68C\uC801 \uC5EC\uD30C\uB97C \uC778\uC9C0\uD558\uACE0, \uC218\uC0C1\uD55C
    \uACE0\uC218\uC775 \uC544\uB974\uBC14\uC774\uD2B8\uC5D0 \uD638\uAE30\uC2EC\uC744
    \uAC16\uC9C0 \uC54A\uB294 \uAC83\uC774 \uC911\uC694\uD558\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b41865e09d13c6749aca3f3a31d83fcc, type: 2}
